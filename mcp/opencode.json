      "skillspector",
      "mcp"
    ]
  },
  "reticle": {
    "type": "local",
    "command": [
      "npx",
      "@reticlehq/server",
      "mcp"
    ]
  },
  "alphavantage": {
    "type": "local",
    "command": [
      "uvx",
      "--with",
      "mcp<2",
      "alphavantage-mcp"
    ],
    "environment": {
      "ALPHAVANTAGE_API_KEY": "demo"
    },
    "cwd": "/home/notjitin/Work/scratch/alphavantage-mcp-work"
  },
  "deepwiki": {
    "type": "remote",
    "url": "https://mcp.deepwiki.com/mcp"
  },
  "industrylens": {
    "type": "remote",
    "url": "https://api.industry-lens.com/mcp/public"
