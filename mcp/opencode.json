  "jevnav": {
    "type": "local",
    "command": [
      "uvx",
      "--from",
      "jevnav[mcp]",
      "jevnav",
      "mcp"
    ]
  },
  "aceternity": {
    "type": "local",
    "command": [
      "npx",
      "-y",
      "aceternityui-mcp@latest"
    ]
  },
  "magicui": {
    "type": "local",
    "command": [
      "npx",
      "-y",
      "@magicuidesign/mcp@latest"
    ]
  },
  "mcp": {
    "tradingview": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "--rm",
        "-i",
        "-v",
        "tradingview-mcp-session:/data",
        "-e",
        "TV_SESSION_FILE=/data/.tv_session.json",
        "mikeh1975/tradingview-mcp:latest"
      ],
      "enabled": true
    },
    "ctrader-remote": {
      "type": "remote",
      "url": "${CTRADER_REMOTE_MCP_URL}",
      "enabled": false
    }
  },
  "laya-browser": {
    "type": "local",
    "command": [
      "/home/notjitin/Work/laya-browser-agent/.venv/bin/localdecide-mcp"
    ]
  }
}