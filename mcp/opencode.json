    "type": "local",
    "command": [
      "npx",
      "-y",
      "@google-cloud/gcloud-mcp"
    ],
    "enabled": false
  },
  "next-devtools": {
    "type": "local",
    "command": [
      "npx",
      "-y",
      "next-devtools-mcp@latest"
    ]
  },
  "chrome-devtools": {
    "type": "local",
    "command": [
      "npx",
      "-y",
      "chrome-devtools-mcp@latest"
    ]
