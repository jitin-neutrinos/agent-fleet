  "github": {
    "type": "local",
    "command": [
      "docker",
      "run",
      "-i",
      "--rm",
      "-e",
      "GITHUB_PERSONAL_ACCESS_TOKEN",
      "ghcr.io/github/github-mcp-server",
      "stdio"
    ],
    "environment": {
      "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}"
    }
  },
  "serena": {
    "type": "local",
    "command": [
      "uvx",
      "--from",
      "git+https://github.com/oraios/serena",
      "serena",
      "start-mcp-server",
      "--context",
      "ide-assistant"
    ]
  },
  "sequential-thinking": {
    "type": "local",
    "command": [
      "npx",
      "-y",
      "@modelcontextprotocol/server-sequential-thinking@latest"
    ]
  },
  "n8n": {
    "type": "local",
    "command": [
      "npx",
      "-y",
      "n8n-mcp@latest"
    ]
  },
  "excalidraw": {
    "type": "local",
    "command": [
