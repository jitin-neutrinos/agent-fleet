{
  "context7": {
    "type": "remote",
    "url": "https://mcp.context7.com/mcp",
    "oauth": false,
    "headers": {
      "Authorization": "Bearer {env:CONTEXT7_API_KEY}"
    }
  },
  "neutrinos-docs": {
    "type": "remote",
    "url": "https://neutrinos-mcp.jitinnair.com/mcp"
  },
  "agentmemory": {
    "type": "local",
    "command": [
      "npx",
      "-y",
      "@agentmemory/mcp"
    ],
    "environment": {
      "AGENTMEMORY_URL": "{env:AGENTMEMORY_URL}",
      "AGENTMEMORY_SECRET": "{env:AGENTMEMORY_SECRET}",
      "AGENTMEMORY_TOOLS": "{env:AGENTMEMORY_TOOLS}"
    }
  },
  "playwright": {
    "type": "local",
    "command": [
      "npx",
      "-y",
      "@playwright/mcp@latest"
    ]
  },
  "shadcn": {
    "type": "local",
    "command": [
      "npx",
      "-y",
      "shadcn@latest",
      "mcp"
    ]
  },
  "laya-decisions": {
    "type": "remote",
    "url": "http://127.0.0.1:8015/mcp",
    "enabled": true
  },
  "graphify": {
    "type": "local",
    "command": [
      "/home/notjitin/.local/bin/graphify-mcp",
      "/home/notjitin/Work/graphify-out/merged-graph.json"
    ]
  },
  "cloudflare-docs": {
    "type": "remote",
    "url": "https://docs.mcp.cloudflare.com/mcp"
