  "figma-context": {
    "type": "local",
    "command": [
      "npx",
      "-y",
      "figma-developer-mcp@latest",
      "--stdio"
    ]
  },
  "firecrawl": {
    "type": "local",
    "command": [
      "npx",
      "-y",
      "firecrawl-mcp@latest"
